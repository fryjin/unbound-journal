{
  "name": "unbound-journal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @unbound-journal/web",
    "build": "npm run build --workspace @unbound-journal/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "papers:validate": "node scripts/validate-paper-pack.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
